# 배포 도메인 (필수, 프로덕션). canonical / sitemap / Open Graph 주소에 쓰입니다.
NEXT_PUBLIC_SITE_URL=

# 검색엔진 소유권 확인 코드 (선택)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=

# 백엔드(minj-shalom-backend) 주소 - 끝의 /api 는 붙이지 않습니다. (기본값 http://localhost:4000)
NEXT_PUBLIC_API_ENDPOINT=

# 콘솔 '반영' 직후 사이트 캐시를 바로 갱신하는 /api/revalidate 의 인증 값 (서버 전용, NEXT_PUBLIC_ 아님).
# 백엔드의 SITE_REVALIDATE_SECRET 과 같은 값이어야 하고, 비워 두면 엔드포인트가 닫혀 있어 반영해도 최대 1분 뒤에 바뀝니다.
REVALIDATE_SECRET=
